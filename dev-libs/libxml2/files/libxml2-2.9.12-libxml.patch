diff --git a/python/libxml.c b/python/libxml.c
index ee6894f..dc5c4f1 100644
--- a/python/libxml.c
+++ b/python/libxml.c
@@ -287,7 +287,10 @@ xmlPythonFileReadRaw (void * context, char * buffer, int len) {
 #endif
     file = (PyObject *) context;
     if (file == NULL) return(-1);
-    ret = PyEval_CallMethod(file, (char *) "read", (char *) "(i)", len);
+    /* When read() returns a string, the length is in characters not bytes, so
