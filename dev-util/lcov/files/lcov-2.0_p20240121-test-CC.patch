@@ -94,7 +96,7 @@ PARENT=`(cd .. ; pwd)`
 
 LCOV_OPTS="--branch-coverage $PARALLEL $PROFILE"
 
-IFS='.' read -r -a VER <<< `gcc -dumpversion`
+IFS='.' read -r -a VER <<< `${CC} -dumpversion`
 
 rm -rf *.gcda *.gcno a.out *.info* *.txt* *.json dumper* testRC *.gcov *.gcov.*
 
@@ -106,12 +108,12 @@ if [[ 1 == $CLEAN_ONLY ]] ; then
     exit 0
 fi
 
-if ! type g++ >/dev/null 2>&1 ; then
-        echo "Missing tool: g++" >&2
+if ! type ${CXX} >/dev/null 2>&1 ; then
+        echo "Missing tool: ${CXX}" >&2
         exit 2
 fi
 
-g++ -std=c++1y --coverage exception.cpp
+${CXX} -std=c++1y --coverage exception.cpp
 if [ 0 != $? ] ; then
     echo "Error:  unexpected error from gcc"
     exit 1
diff --git a/tests/lcov/extract/extract.sh b/tests/lcov/extract/extract.sh
index 0cdec93..aa1ba2a 100755
--- a/tests/lcov/extract/extract.sh
+++ b/tests/lcov/extract/extract.sh
@@ -6,6 +6,8 @@ COVER=
 
