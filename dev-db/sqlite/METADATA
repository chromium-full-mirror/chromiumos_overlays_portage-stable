# Metadata for CVEs that are fixed or don't affect ChromeOS.

third_party {
  security {
    # CVE-2026-119586 only affects the sqlite3 CLI .recover dot-command
    # (ext/recover/sqlite3recover.c) when run on an untrusted database and its
    # output is piped back into sqlite3; it is not compiled into libsqlite3.so.
    # On ChromeOS target boards, /usr/bin/sqlite* is masked out via
    # chromiumos-overlay/dev-db/sqlite/sqlite.bashrc and is never shipped on
    # devices, while in the SDK (cros_host) sqlite3 only runs on trusted build
    # inputs. Upstream SQLite 3.54.1 is the latest release.
    mitigated_security_patch: "CVE-2026-119586"
  }
}
