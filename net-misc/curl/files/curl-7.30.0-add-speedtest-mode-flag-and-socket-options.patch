diff '--color=auto' -Naur curl-7.78.0.orig/lib/transfer.c curl-7.78.0/lib/transfer.c
--- curl-7.78.0.orig/lib/transfer.c	2022-05-26 12:06:47.299566805 -0700
+++ curl-7.78.0/lib/transfer.c	2022-05-26 12:11:59.287863981 -0700
@@ -602,8 +602,14 @@
     }
 
     if(bytestoread) {
-      /* receive data from the network! */
-      result = Curl_read(data, conn->sockfd, buf, bytestoread, &nread);
+      /* discard payload data in speedtest mode */
+      if (!k->header && data->set.speedtest_mode) {
+        nread = recv(conn->sockfd, buf, bytestoread, MSG_TRUNC);
+        result = (nread < 0) ? CURLE_READ_ERROR : CURLE_OK;
+      } else {
+        /* receive data from the network! */
+        result = Curl_read(data, conn->sockfd, buf, bytestoread, &nread);
+      }
 
       /* read would've blocked */
       if(CURLE_AGAIN == result)
