diff '--color=auto' -Naur curl-7.78.0.orig/lib/connect.c curl-7.78.0/lib/connect.c
--- curl-7.78.0.orig/lib/connect.c	2022-05-26 12:06:47.295566853 -0700
+++ curl-7.78.0/lib/connect.c	2022-05-26 12:09:26.193681500 -0700
@@ -1342,8 +1342,16 @@
     }
   }
 
-  if(!result)
+  if(!result) {
     *sockp = sockfd;
+    if(data->set.speedtest_mode) {
+      int rcvlowat = data->set.buffer_size;
+      if (setsockopt(sockfd, SOL_SOCKET, SO_RCVLOWAT,
+                     &rcvlowat, sizeof(rcvlowat)) == -1) {
+        failf(data, "Failed to set SO_RCVLOWAT");
+      }
+    }
+  }
 
   return result;
 }
