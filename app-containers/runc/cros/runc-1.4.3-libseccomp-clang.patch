Fix duplicate switch case compile error with Clang and libseccomp < 2.6.0.

When building against libseccomp < 2.6.0 (ChromeOS provides libseccomp-2.5.4),
SCMP_ARCH_LOONGARCH64, SCMP_ARCH_M68K, SCMP_ARCH_SH, and SCMP_ARCH_SHEB all
fall back to ARCH_BAD (0xffffffff). Clang emits DWARF const values for
`const uint32_t C_ARCH_*`, causing Go cgo to emit compile-time constants and
fail with duplicate switch cases in `archFromNative`. Guard `C_ARCH_BAD` first
and use a boolean switch (matching upstream seccomp/libseccomp-golang PR #121).

Bug: b/552188279

--- a/vendor/github.com/seccomp/libseccomp-golang/seccomp_internal.go
+++ b/vendor/github.com/seccomp/libseccomp-golang/seccomp_internal.go
@@ -517,55 +517,58 @@
 }
 
 func archFromNative(a C.uint32_t) (ScmpArch, error) {
-	switch a {
-	case C.C_ARCH_X86:
+	if a == C.C_ARCH_BAD {
+		return 0x0, fmt.Errorf("unrecognized architecture %#x", uint32(a))
+	}
+	switch {
+	case a == C.C_ARCH_X86:
 		return ArchX86, nil
-	case C.C_ARCH_X86_64:
+	case a == C.C_ARCH_X86_64:
 		return ArchAMD64, nil
-	case C.C_ARCH_X32:
+	case a == C.C_ARCH_X32:
 		return ArchX32, nil
-	case C.C_ARCH_ARM:
+	case a == C.C_ARCH_ARM:
 		return ArchARM, nil
-	case C.C_ARCH_NATIVE:
+	case a == C.C_ARCH_NATIVE:
 		return ArchNative, nil
-	case C.C_ARCH_AARCH64:
+	case a == C.C_ARCH_AARCH64:
 		return ArchARM64, nil
-	case C.C_ARCH_MIPS:
+	case a == C.C_ARCH_MIPS:
 		return ArchMIPS, nil
-	case C.C_ARCH_MIPS64:
+	case a == C.C_ARCH_MIPS64:
 		return ArchMIPS64, nil
-	case C.C_ARCH_MIPS64N32:
+	case a == C.C_ARCH_MIPS64N32:
 		return ArchMIPS64N32, nil
-	case C.C_ARCH_MIPSEL:
+	case a == C.C_ARCH_MIPSEL:
 		return ArchMIPSEL, nil
-	case C.C_ARCH_MIPSEL64:
+	case a == C.C_ARCH_MIPSEL64:
 		return ArchMIPSEL64, nil
-	case C.C_ARCH_MIPSEL64N32:
+	case a == C.C_ARCH_MIPSEL64N32:
 		return ArchMIPSEL64N32, nil
-	case C.C_ARCH_PPC:
+	case a == C.C_ARCH_PPC:
 		return ArchPPC, nil
-	case C.C_ARCH_PPC64:
+	case a == C.C_ARCH_PPC64:
 		return ArchPPC64, nil
-	case C.C_ARCH_PPC64LE:
+	case a == C.C_ARCH_PPC64LE:
 		return ArchPPC64LE, nil
-	case C.C_ARCH_S390:
+	case a == C.C_ARCH_S390:
 		return ArchS390, nil
-	case C.C_ARCH_S390X:
+	case a == C.C_ARCH_S390X:
 		return ArchS390X, nil
-	case C.C_ARCH_PARISC:
+	case a == C.C_ARCH_PARISC:
 		return ArchPARISC, nil
-	case C.C_ARCH_PARISC64:
+	case a == C.C_ARCH_PARISC64:
 		return ArchPARISC64, nil
-	case C.C_ARCH_RISCV64:
+	case a == C.C_ARCH_RISCV64:
 		return ArchRISCV64, nil
-	case C.C_ARCH_LOONGARCH64:
+	case a == C.C_ARCH_LOONGARCH64:
 		return ArchLOONGARCH64, nil
-	case C.C_ARCH_M68K:
+	case a == C.C_ARCH_M68K:
 		return ArchM68K, nil
-	case C.C_ARCH_SH:
+	case a == C.C_ARCH_SH:
 		return ArchSH, nil
-	case C.C_ARCH_SHEB:
+	case a == C.C_ARCH_SHEB:
 		return ArchSHEB, nil
 	default:
 		return 0x0, fmt.Errorf("unrecognized architecture %#x", uint32(a))
 	}
